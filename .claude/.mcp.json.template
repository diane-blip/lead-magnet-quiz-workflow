{
  "_comment": "SRC-adapted MCP set. DROPPED from the original: notion, glif, supabase. Kit (email) and image generation are connected at the ACCOUNT level in Diane's Claude environment, not as project-local npx servers, so they are not listed here. The servers below are the build-time research/scrape tools. Runtime never uses MCP — the deployed Cloudflare Worker talks to Kit via REST API v4.",
  "mcpServers": {
    "memory": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "env": {
        "MEMORY_FILE_PATH": "./.claude/memory.json"
      }
    },
    "tavily": {
      "command": "npx",
      "args": ["-y", "tavily-mcp@latest"],
      "env": {
        "TAVILY_API_KEY": "YOUR_TAVILY_API_KEY"
      }
    },
    "dfs-mcp": {
      "command": "npx",
      "args": ["-y", "dataforseo-mcp-server"],
      "env": {
        "DATAFORSEO_USERNAME": "YOUR_DATAFORSEO_USERNAME",
        "DATAFORSEO_PASSWORD": "YOUR_DATAFORSEO_PASSWORD"
      }
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"]
    },
    "browserbase": {
      "command": "npx",
      "args": ["@browserbasehq/mcp-server-browserbase"],
      "env": {
        "BROWSERBASE_API_KEY": "YOUR_BROWSERBASE_API_KEY",
        "BROWSERBASE_PROJECT_ID": "YOUR_BROWSERBASE_PROJECT_ID"
      }
    }
  }
}
